[Unit]
Description=Aux white LED on GPIO13 (always on at boot)
After=multi-user.target

[Service]
Type=simple
# {SCRIPT_DIR} is rewritten by install_aux_led.sh to the absolute path of
# this repo on the Pi (e.g. /home/stratela/rfid-vision-simple-led-test).
ExecStart=/usr/bin/python3 {SCRIPT_DIR}/aux_led.py
WorkingDirectory={SCRIPT_DIR}
Restart=on-failure
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
