[Unit]
Description=RFID + LED system (rfid_reader + WS2812 strip + aux GPIO13 white LED)
After=multi-user.target

[Service]
Type=simple
# {SCRIPT_DIR} is rewritten by install_boot.sh to the absolute path of this
# repo on the Pi (e.g. /home/stratela/rfid-vision-simple-led-test).
ExecStart=/bin/bash {SCRIPT_DIR}/system.sh
WorkingDirectory={SCRIPT_DIR}
Restart=on-failure
RestartSec=5
User=root
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
